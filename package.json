{
  "name": "itest-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-plugin-registry.ts && vite",
    "build": "tsx scripts/generate-plugin-registry.ts && vue-tsc -b && vite build",
    "preview": "vite preview",
    "plugins:sync": "tsx scripts/sync-plugins.ts",
    "plugins:generate": "tsx scripts/generate-plugin-registry.ts",
    "plugins:update": "tsx scripts/sync-plugins.ts && tsx scripts/generate-plugin-registry.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@itest/frontend-sdk": "file:./packages/frontend-sdk",
    "augmented-ui": "^2.0.0",
    "axios": "^1.7.9",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.1",
    "tabulator-tables": "6.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.6.2",
    "daisyui": "4.12.24",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
