{
  "id": "testing",
  "name": "TESTING",
  "version": "1.1.0",
  "sdkVersion": "^1.0.0",
  "type": "FRONTEND",
  "description": "Bộ công cụ kiểm thử LoRaWAN toàn diện: Gateway Testing kết nối ChirpStack, Device Simulation giả lập thiết bị (OTAA/ABP, RF params, payload builder) và Device Auto Check kiểm tra tự động kết quả gói tin.",
  "author": "ITEST IoT Platform Team",
  "frontend": "frontend/index.ts",
  "enabledByDefault": true,
  "permissions": [
    {
      "namespace": "testing",
      "resource": "packet",
      "action": "view"
    },
    {
      "namespace": "testing",
      "resource": "gateway-session",
      "action": "manage"
    },
    {
      "namespace": "testing",
      "resource": "device-simulation",
      "action": "manage"
    },
    {
      "namespace": "testing",
      "resource": "device-auto-check",
      "action": "manage"
    },
    {
      "namespace": "testing",
      "resource": "create-device-testing",
      "action": "manage"
    },
    {
      "namespace": "testing",
      "resource": "device-test",
      "action": "manage"
    }
  ]
}
